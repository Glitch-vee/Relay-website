# Copy to .env.local for local development. Never commit real values.

# Supabase project URL. Server-only. Do not prefix with NEXT_PUBLIC_.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Supabase publishable (anon) key. Server-only.
# The site calls security-definer functions with this key. Never use a NEXT_PUBLIC_ prefix.
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Password for the private /stats page. Sent only over the login form.
STATS_PASSWORD=choose-a-long-password

# Secret passed to lead_list. Server-only. Must match the app_secrets row
# where key is leads_secret. Do not commit the real value.
LEADS_SECRET=choose-another-long-secret
